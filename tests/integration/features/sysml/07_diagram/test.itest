#
# Export SysML documents with a PlantUML diagram at the top of each document.
#
# The diagram is a placeholder with the options of a PlantUML !include_sysml
# directive and the script that draws it in the browser. It comes before the
# first doc comment of the file. A requirements document draws its
# requirements and their traces, each box a link to its node; a design
# document draws its definitions.
#

RUN: %strictdoc export %S --formats=html --output-dir %T --config %S/strictdoc_config.py | filecheck %s --dump-input=fail
CHECK: Export completed.

RUN: %cat %T/html/%THIS_TEST_FOLDER/requirements.html | filecheck %s --dump-input=fail --check-prefix CHECK-REQ
CHECK-REQ-NOT: <pre class="mermaid">
CHECK-REQ: <div class="sysml-diagram" data-sysml-document="true" data-sysml-options="view=requirements root=&quot;Diagram requirements&quot; depth=1 orientation=horizontal text=false links=/?a={id}"></div>
CHECK-REQ: <script type="module" src="/_static/plantuml/sysml/sysml-diagrams.js"></script>
CHECK-REQ: Requirements text below the diagram.

RUN: %cat %T/html/%THIS_TEST_FOLDER/design.html | filecheck %s --dump-input=fail --check-prefix CHECK-DESIGN
CHECK-DESIGN: <div class="sysml-diagram" data-sysml-document="true" data-sysml-options="view=definitions root=
CHECK-DESIGN: sysml-diagrams.js
