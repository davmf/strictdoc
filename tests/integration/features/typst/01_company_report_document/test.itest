#
# Export a document in the company report style: the report header with the
# document metadata and the revision history of the REVISION nodes, sections,
# a table of requirements with their fields and relations, links, an anchor,
# an image, a table, a code block and a Mermaid diagram.
#

RUN: %strictdoc export --formats=typst --output-dir %T "%S/input.sdoc" | filecheck %s --dump-input=fail
CHECK-NOT: warning: Typst export
CHECK: Step 'Export SDoc' took

RUN: %diff "%T/typst/input.typ" "%S/expected/input.typ"
RUN: %check_exists --file "%T/typst/strictdoc.typ"
RUN: %check_exists --file "%T/typst/_assets/logo.svg"
