# Copy to .env and fill in.

# Public host name. Caddy gets a TLS certificate for it automatically, so DNS
# must point here and ports 80/443 must be reachable.
STRICTDOC_DOMAIN=strictdoc.example.com

# Absolute path to the Git clone of the project to serve.
STRICTDOC_PROJECT_DIR=/srv/strictdoc/project

# Owner of STRICTDOC_PROJECT_DIR on the host (id -u / id -g).
STRICTDOC_UID=1000
STRICTDOC_GID=1000

# Set to true to add Chrome and the html2pdf extra, for the HTML2PDF export.
# Typst PDFs do not need it.
INSTALL_CHROME=false

# SSO, from your identity provider's OIDC client registration.
# Redirect URI to register: https://<STRICTDOC_DOMAIN>/oauth2/callback
OIDC_PROVIDER=oidc
OIDC_ISSUER_URL=https://login.example.com/realms/example
OIDC_CLIENT_ID=strictdoc
OIDC_CLIENT_SECRET=
# Comma-separated, e.g. example.com. Use * to allow any account the IdP accepts.
OIDC_EMAIL_DOMAINS=example.com

# Scope requested at sign-in. Add "groups" if your provider only sends the
# groups claim when asked (e.g. "openid email profile groups").
OIDC_SCOPE=openid email profile
# Name of the ID token claim that lists the user's groups.
OIDC_GROUPS_CLAIM=groups

# Roles. Members of the editor group can edit, members of the admin group can
# also edit grammars. Everyone else who can sign in can only read. Use the
# group names exactly as your provider sends them in the groups claim.
STRICTDOC_EDITOR_GROUP=strictdoc-editors
STRICTDOC_ADMIN_GROUP=strictdoc-admins

# Generate with:
#   python3 -c 'import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
OAUTH2_PROXY_COOKIE_SECRET=
