#!/bin/sh
# Prints strictdoc.ps1, the PowerShell script that runs this image, with the
# image's name as its default image:
#
#   docker run --rm --entrypoint strictdoc-launcher <image> > strictdoc.ps1
#
# The name is the first argument, else STRICTDOC_IMAGE_NAME of the image.
image="${1:-$STRICTDOC_IMAGE_NAME}"
case "$image" in
    *[!A-Za-z0-9._:/@-]*|"")
        echo "strictdoc-launcher: not an image name: '$image'" >&2
        exit 2
        ;;
esac
sed "s|^\$DefaultImage = \"strictdoc:local\"|\$DefaultImage = \"$image\"|" \
    /usr/local/share/strictdoc/strictdoc.ps1
